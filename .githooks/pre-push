#!/usr/bin/env bash
# Runs `npm run verify` (lockfile check, type-check, tests, build) against each commit being
# pushed, so a push that would fail the Pages workflow fails here instead.
#
# It checks the pushed commit in a throwaway worktree, not the working tree: uncommitted edits
# can't make it pass, and a new file you forgot to `git add` makes it fail, as it would in CI.
# The worktree borrows this checkout's node_modules, so run `npm install` after changing
# dependencies. Skip the hook with `git push --no-verify`.
#
# Installed by `npm install` (the `prepare` script points core.hooksPath at .githooks).

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
zero_sha="0000000000000000000000000000000000000000"

# Use the Node from .nvmrc. A login shell's default Node can be older than the project's
# floor, which fails in ways CI never would.
if [ -s "${NVM_DIR:-$HOME/.nvm}/nvm.sh" ]; then
  # shellcheck disable=SC1091
  . "${NVM_DIR:-$HOME/.nvm}/nvm.sh" --no-use
  nvm use --silent "$(cat "$repo_root/.nvmrc")" >/dev/null ||
    { echo "pre-push: nvm could not switch to the Node in .nvmrc (try: nvm install)" >&2; exit 1; }
fi
node_major="$(node -p 'process.versions.node.split(".")[0]')"
if [ "$node_major" -lt 22 ]; then
  echo "pre-push: Node $(node --version) is too old for this project (see .nvmrc)." >&2
  exit 1
fi

if [ ! -d "$repo_root/node_modules" ]; then
  echo "pre-push: no node_modules; run npm install first." >&2
  exit 1
fi

checked=""
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  # A deleted branch has nothing to build; the same commit pushed to two refs is built once.
  [ "$local_sha" = "$zero_sha" ] && continue
  case " $checked " in *" $local_sha "*) continue ;; esac
  checked="$checked $local_sha"

  worktree="$(mktemp -d "${TMPDIR:-/tmp}/pre-push.XXXXXX")"
  cleanup() { git -C "$repo_root" worktree remove --force "$worktree" >/dev/null 2>&1 || rm -rf "$worktree"; }
  trap cleanup EXIT

  echo "pre-push: verifying $(git log --oneline -1 "$local_sha")"
  git -C "$repo_root" worktree add --detach --quiet "$worktree" "$local_sha"
  ln -s "$repo_root/node_modules" "$worktree/node_modules"

  if ! (cd "$worktree" && npm run --silent verify); then
    echo "" >&2
    echo "pre-push: verify failed for $local_sha, so nothing was pushed." >&2
    echo "pre-push: fix it, or push anyway with: git push --no-verify" >&2
    exit 1
  fi

  cleanup
  trap - EXIT
done

exit 0
